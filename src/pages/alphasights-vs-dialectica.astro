---
import BaseLayout from '../layouts/BaseLayout.astro';
import VsComparison from '../components/VsComparison.astro';
import { getCollection } from 'astro:content';

const allNetworks = await getCollection('networks');
const a = allNetworks.find(n => n.data.slug === 'alphasights')!;
const b = allNetworks.find(n => n.data.slug === 'dialectica')!;

const verdict = [
  a.data.description,
  a.data.pricingDetail || 'Not disclosed',
  b.data.description,
  b.data.pricingDetail || 'Not disclosed',
];
---

<BaseLayout
  title="AlphaSights vs Dialectica: Expert Network Comparison (2026) | ExpertNetworks.net"
  description="Compare AlphaSights and Dialectica expert networks. Fast managed service vs. deep research specialist — pricing, expert sourcing, AI capabilities, and compliance compared."
  canonicalPath="/alphasights-vs-dialectica"
  ogType="article"
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://expertnetworks.net/" },
          { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://expertnetworks.net/compare" },
          { "@type": "ListItem", "position": 3, "name": "AlphaSights vs Dialectica" }
        ]
      },
      {
        "@type": "Article",
        "headline": "AlphaSights vs Dialectica: Expert Network Comparison (2026)",
        "description": "Head-to-head comparison of AlphaSights and Dialectica expert networks across pricing, depth, AI, and services.",
        "publisher": { "@type": "Organization", "name": "ExpertNetworks.net", "url": "https://expertnetworks.net" },
        "datePublished": "2026-03-09",
        "dateModified": "2026-03-09"
      }
    ]
  }}
>
  <section class="pt-32 pb-16 px-6 bg-gradient-to-b from-bg-secondary to-bg-primary">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <a href="/compare/" class="text-accent text-sm font-medium no-underline hover:underline">&larr; Compare All Networks</a>
      </div>
      <span class="inline-block px-3 py-1 bg-accent/10 text-accent text-xs font-semibold rounded-full mb-4 tracking-wide uppercase">Head-to-Head</span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-primary mb-6 leading-tight">AlphaSights vs Dialectica</h1>
      <p class="text-lg text-secondary max-w-3xl leading-relaxed">
        High-speed managed service vs. deep-research specialist. Two distinct approaches to expert network access for investment professionals.
      </p>
    </div>
  </section>

  <VsComparison a={a} b={b} verdict={verdict} />
</BaseLayout>
